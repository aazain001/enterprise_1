table dim_customers
	lineageTag: 7385e544-57a1-4a00-8b09-df1dac585f00
	sourceLineageTag: [dbo].[dim_customers]

	measure 'Total Items Sold' = SUM(fact_sales[quantity])
		formatString: 0
		lineageTag: b3ee118e-42a9-489e-8fc5-bc8d50e1567d

		changedProperty = Name

	measure 'Active Customers' = DISTINCTCOUNT(dim_customers[customer_id])
		formatString: 0
		lineageTag: a766b84b-0e67-44b0-8f94-e8d9f094fef4

		changedProperty = Name

	measure 'Total Orders' = COUNTA(fact_sales[order_id])
		formatString: 0
		lineageTag: a18bf5ec-559e-40f3-945c-e63ec0fb02e7

		changedProperty = Name

	measure 'Avg Quantity per Order' = DIVIDE([Total Items Sold], [Total Orders])
		lineageTag: 1563af90-1943-45ef-9dca-e4bee20db670

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

